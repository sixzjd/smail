# smail bridge 配置示例
#
# 复制成 .env（或直接写进 systemd 的 EnvironmentFile）后按需修改。
# 只填了 SMAIL_API_BASE 也能跑起来，其它都是可选项。

# ---------------------------------------------------------------- 站点地址
# 你的 smail 站点，bridge 就是通过这个地址的 HTTP API 读信、发信的。
# 本地调试写成 http://127.0.0.1:8787 即可。
SMAIL_API_BASE=https://mail.sixzjd.sbs

# 调用 smail 接口的超时时间（毫秒）
# SMAIL_API_TIMEOUT=30000

# ---------------------------------------------------------------- IMAP 收件
# 客户端里填写的服务器地址（写进自动配置，留空就不公布）
IMAP_HOST=imap.sixzjd.sbs

# 明文端口（STARTTLS 可用）与隐式 TLS 端口
IMAP_PORT=143
IMAP_TLS_PORT=993

# 是否允许明文 143：公网环境建议 false，只留 993
# IMAP_ALLOW_PLAIN=true

# 每个文件夹最多同步多少封邮件（越大越慢）
# IMAP_MAX_MESSAGES=300

# 空闲连接多久自动断开（毫秒）
# IMAP_IDLE_TIMEOUT=1800000

# ---------------------------------------------------------------- SMTP 发件
SMTP_HOST=imap.sixzjd.sbs

# 587 = STARTTLS，465 = 隐式 TLS，25 = 兼容老客户端（iOS 手动设置默认就是 25）
SMTP_PORT=587
SMTP_TLS_PORT=465
SMTP_LEGACY_PORT=25

# 是否允许明文连接后用 STARTTLS 升级
# SMTP_ALLOW_STARTTLS=true

# 允许不加密直接投递（只在纯内网调试时打开）
# SMTP_DISABLE_SECURE=false

# 单封邮件大小上限（字节）
# SMTP_MAX_MESSAGE_SIZE=26214400

# ---------------------------------------------------------------- TLS 证书
# 建议用 Let's Encrypt 签发的证书。acme.sh 的 DNS-01 方式不需要 root，见 deploy/ 下的脚本。
# 也可以直接写 PEM 内容，方便 docker secrets。
# TLS_CERT_PATH=/etc/letsencrypt/live/imap.sixzjd.sbs/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/imap.sixzjd.sbs/privkey.pem
# TLS_DOMAIN=imap.sixzjd.sbs

# ---------------------------------------------------------------- 其它
# 健康检查端口（GET /health），填 0 表示关闭
HEALTH_PORT=8788
# 默认只绑 127.0.0.1；要做外部探活才改成 0.0.0.0
HEALTH_HOST=127.0.0.1

# debug / info / warn / error
LOG_LEVEL=info
