{
  "name": "smail-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SMTP/IMAP gateway that lets third-party mail clients (iOS Mail, Outlook, Thunderbird) log into smail",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "npm run test:imap && npm run test:write && npm run test:smtp",
    "test:imap": "node test/imap-test.mjs",
    "test:write": "node test/imap-write-test.mjs",
    "test:smtp": "node test/smtp-test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "mailparser": "^3.7.4",
    "smtp-server": "^3.13.6"
  },
  "devDependencies": {
    "imapflow": "^1.0.171",
    "nodemailer": "^6.9.16"
  }
}
