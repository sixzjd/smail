{
  "name": "smail",
  "version": "1.1.0",
  "private": true,
  "description": "smail - Self-hosted email service (local deployment)",
  "scripts": {
    "dev": "concurrently \"npm run dev:workers\" \"npm run dev:web\"",
    "dev:web": "cd web && npx vite --mode dev",
    "build": "cd web && npx vite build --mode release",
    "deploy": "npx wrangler deploy",
    "deploy:web": "cd web && npx vite build --mode release",
    "deploy:all": "npm run deploy:web && npx wrangler deploy",
    "dev:workers": "npx wrangler dev"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "wrangler": "^4.0.0"
  }
}
